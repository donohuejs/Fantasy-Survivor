rules_version = '2';
service cloud.firestore {
  function isAdmin() {
    return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email == 'donohue.js@gmail.com';
  }

  match /databases/{database}/documents {
    match /games/{gameId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // Player decisions are verified by /api/draft using the Admin SDK.
      allow update: if isAdmin();
      match /draftPrivate/{document} {
        // No browser, including the game master's, may inspect the hidden deck.
        allow read, write: if false;
      }
      match /archives/{season} {
        allow read, write: if isAdmin();
      }
      match /signups/{userId} {
        allow create: if isAdmin() || (request.auth != null
          && request.auth.uid == userId
          && request.auth.token.email_verified == true
          && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.email.lower()
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 50
          && request.resource.data.createdAt is string);
        allow update: if isAdmin() || (request.auth != null
          && request.auth.uid == userId
          && !('assignedPlayerId' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 50
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email);
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow delete: if isAdmin();
      }
    }
  }
}
